# Copy this file to ".env" and fill it in. Only the person running the app
# needs to do this; students just click "Log in with Canvas".

# Your school's Canvas address
CANVAS_URL=https://sfsu.instructure.com
SCHOOL_NAME=SFSU

# The AI key (from console.anthropic.com). All students' chats use this key.
ANTHROPIC_API_KEY=

# Optional Neon/Postgres connection string for persistence across restarts.
DATABASE_URL=

# Canvas SSO login: the Developer Key your school's Canvas admins give you
# (see ADMIN-REQUEST.md). Leave blank until you have it.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Only if the admins turned on "Enforce Scopes" for the key: paste the scope
# list they approved, separated by spaces.
CANVAS_SCOPES=

# The web address students use to reach the app. The Canvas login sends
# them back to PUBLIC_URL/auth/callback, so this must match the Developer Key.
PUBLIC_URL=http://localhost:3000

# How hard the AI thinks on typed messages: low (fastest), medium, or high.
# "low" keeps live demos snappy. Voice always uses low.
AI_EFFORT=medium

# Max AI messages per student per day (protects your AI bill).
DAILY_MESSAGE_LIMIT=150

# Allow "Use a Canvas access token instead" on the login page (true/false).
ALLOW_TOKEN_LOGIN=true

# Key used to encrypt Canvas tokens at rest (any long random string).
# Leave blank on a laptop: one is generated in data/secret.key automatically.
TOKEN_ENCRYPTION_KEY=

# Show "Try the demo" (a pretend school with sample classes) on the login page.
DEMO_MODE=true

# PORT=3000
# HOST=0.0.0.0   # needed when hosting for other people
